{
  "name": "hypersignal-v2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:demo": "cross-env DEMO=1 next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && node scripts/patch-cron.mjs && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && node scripts/patch-cron.mjs && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && node scripts/patch-cron.mjs && opennextjs-cloudflare upload",
    "db:create": "wrangler d1 create hypersignal",
    "db:migrate": "wrangler d1 execute hypersignal --remote --file=migrations/0001_init.sql",
    "db:migrate:local": "wrangler d1 execute hypersignal --local --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "next": "15.5.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "cross-env": "^7.0.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.38.0"
  },
  "engines": {
    "node": ">=20"
  }
}
